# Copy to .env, chmod 600, and replace all blank secrets before startup.
# Generate each secret independently with: openssl rand -hex 32
ABELE_MASTER_KEY=
ABELE_TOKEN_PEPPER=
ABELE_PG_PASSWORD=

# Compose-only PostgreSQL settings. Use a hex password (URL-safe); server URL is
# assembled in compose.yml from these values. PostgreSQL is not published.
ABELE_PG_USER=abele
ABELE_PG_DATABASE=abele

# Server defaults below use container paths. Compose overrides DATABASE_URL for
# PostgreSQL; for SQLite remove that override and the postgres dependency/service.
ABELE_DATABASE_URL=sqlite:///data/abele.db
ABELE_BLOB_DIR=/data/blobs
ABELE_PUBLIC_URL=http://localhost:8787
ABELE_HOST=0.0.0.0
ABELE_PORT=8787
ABELE_TRUST_PROXY=false
ABELE_SCOPED_SHARING=off
# .obsidian is always registered; additional roots are a JSON array (max 16).
ABELE_CONFIGURATION_DIRS='[]'

# Compose-only: loopback HTTP by default. Do not expose plain HTTP publicly.
ABELE_BIND=127.0.0.1
# For --profile tls, set a real domain and PUBLIC_URL=https://that-domain.
# Restrict TRUST_PROXY to the proxy IP/CIDR; never trust arbitrary public peers.
ABELE_DOMAIN=sync.example.com

# Tests only, against a disposable database with create/drop database privileges:
# ABELE_TEST_PG_URL=postgres://postgres:test-only@localhost:5432/postgres
