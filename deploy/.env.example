# Copy to .env and chmod 600. Generate each secret separately: openssl rand -hex 32
# Keep ABELE_MASTER_KEY and ABELE_TOKEN_PEPPER outside this machine as well:
# without them a backup cannot be read and issued keys stop working.

# Server release, exact version: https://github.com/dudaanton/abele-sync/releases
ABELE_VERSION=0.5.0

ABELE_MASTER_KEY=
ABELE_TOKEN_PEPPER=
POSTGRES_PASSWORD=

# The HTTPS address your devices use (nginx domain or Tailscale serve address).
ABELE_PUBLIC_URL=https://sync.example.com

# Loopback port the proxy forwards to.
ABELE_PORT=8787

# Addresses of the proxy as the container sees it (comma-separated IPs/CIDRs), or false.
# false is safe; the only cost is one shared rate limit for every client.
ABELE_TRUST_PROXY=false
